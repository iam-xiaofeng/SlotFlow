# SlotFlow backend example configuration.
#
# Copy this file to backend/.env and fill in at least one provider API key.
# backend/.env is intentionally ignored by git; do not commit real secrets.
# Relative paths below are resolved from the backend/ directory when using `make dev`.


# --- Model Providers ---------------------------------------------------------
# Uncomment the providers you want to use. Official base URLs are shown for clarity;
# leave *_BASE_URL unset to use the built-in official endpoint.
# Runtime calls use ChatLiteLLM; credentials and model selection remain server-side.

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Any LiteLLM-native provider is discovered from its standard environment variables.
# Common examples:
# GEMINI_API_KEY=...
# MISTRAL_API_KEY=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# Custom OpenAI-compatible relay. CUSTOM_BASE_URL has no built-in default.
# CUSTOM_BASE_URL=https://your-relay.example.com/v1
# CUSTOM_API_KEY=sk-...
# CUSTOM_MODELS=claude-sonnet-4,gpt-5,qwen-max
SLOTFLOW_RELAY_USER_AGENT=SlotFlow/1.0


# --- FastAPI / Frontend ------------------------------------------------------
SLOTFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend-only variables are documented here for convenience, but the Next.js
# process does not automatically read backend/.env. Export them in the frontend
# shell or put them in frontend/.env.local if you need non-default URLs.
# SLOTFLOW_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_SLOTFLOW_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SLOTFLOW_STREAM_BASE_URL=http://localhost:8000


# --- App Storage -------------------------------------------------------------
SLOTFLOW_CHAT_SQLITE_PATH=.slotflow/chat.sqlite3

SLOTFLOW_CHECKPOINTER_BACKEND=memory
SLOTFLOW_CHECKPOINTER_SQLITE_PATH=.slotflow/checkpoints.sqlite3
# SLOTFLOW_CHECKPOINTER_POSTGRES_URI=postgresql://slotflow:slotflow@localhost:5432/slotflow
SLOTFLOW_CHECKPOINTER_SETUP=true

# Optional global system prompt override. Leave commented to use the built-in prompt.
# SLOTFLOW_SYSTEM_PROMPT=You are SlotFlow.


# --- Harness Features --------------------------------------------------------
# Defaults keep all SlotFlow features on. Set a flag to false only when debugging
# a specific subsystem or running a constrained local environment.
SLOTFLOW_RUNTIME_SUMMARY_MIDDLEWARE=true
SLOTFLOW_ARTIFACT_DISCOVERY_MIDDLEWARE=true
SLOTFLOW_SUMMARIZATION_MIDDLEWARE=true
SLOTFLOW_SUMMARIZATION_TRIGGER_TOKENS=600000
SLOTFLOW_SUMMARIZATION_KEEP_MESSAGES=20
SLOTFLOW_SUMMARIZATION_TRIM_TOKENS=8000
SLOTFLOW_LONG_TERM_MEMORY_ENABLED=true
SLOTFLOW_PROACTIVE_MEMORY_EXTRACTION=true
SLOTFLOW_SKILLS_PREFLIGHT_MIDDLEWARE=true
SLOTFLOW_CLARIFY_GATE=true
SLOTFLOW_UPLOADS_MIDDLEWARE=true
SLOTFLOW_TODO_MIDDLEWARE=true
SLOTFLOW_SUBAGENT_LIMIT=true
SLOTFLOW_SUBAGENT_MAX_CONCURRENT=3
SLOTFLOW_SUBAGENT_RECURSION_LIMIT=100


# --- Skills / Memory / MCP ---------------------------------------------------
SLOTFLOW_SKILLS_ROOT=.slotflow/skills
SLOTFLOW_SKILLS_CONFIG_PATH=.slotflow/skills.json
# SLOTFLOW_ENABLED_SKILLS=find-skills,my-skill

SLOTFLOW_MEMORY_SQLITE_PATH=.slotflow/memory.sqlite3

SLOTFLOW_MCP_ENABLED=true
SLOTFLOW_MCP_CONFIG_PATH=.slotflow/mcp.json
# SLOTFLOW_MCP_SERVERS=search,docs
# SLOTFLOW_MCP_CONFIG_JSON={"search":{"transport":"stdio","command":"npx","args":["-y","your-mcp-server"]}}


# --- Workspace / Network / Docker Sandbox -----------------------------------
SLOTFLOW_WORKSPACE_ROOT=.slotflow/workspace
SLOTFLOW_WORKSPACE_WRITES_ENABLED=true
SLOTFLOW_WORKSPACE_MAX_READ_BYTES=1048576
SLOTFLOW_WORKSPACE_MAX_WRITE_BYTES=1048576

SLOTFLOW_NETWORK_ENABLED=true
SLOTFLOW_NETWORK_ALLOW_PRIVATE=false
SLOTFLOW_NETWORK_MAX_FETCH_BYTES=524288
SLOTFLOW_NETWORK_TIMEOUT_SECONDS=15

SLOTFLOW_CODE_EXECUTION_ENABLED=true
SLOTFLOW_DOCKER_SANDBOX_IMAGE=python:3.12
SLOTFLOW_DOCKER_SANDBOX_TIMEOUT_SECONDS=120
SLOTFLOW_DOCKER_SANDBOX_NETWORK_ENABLED=true
SLOTFLOW_DOCKER_SANDBOX_IDLE_TIMEOUT_SECONDS=600
SLOTFLOW_ALLOW_HOST_DOCKER_INSTALL=true


# --- Terminal / Titles -------------------------------------------------------
# SLOTFLOW_TERMINAL_CWD=/absolute/path/to/start/in
# SLOTFLOW_TERMINAL_SHELL=/bin/bash

SLOTFLOW_TITLE_MODEL_ENABLED=true
# SLOTFLOW_TITLE_MODEL=deepseek/deepseek-v4-pro


# --- bootstrap.sh knobs ------------------------------------------------------
# These are read only by ./bootstrap.sh. Export them in the shell before running
# bootstrap; backend/.env is created during bootstrap and is not read by bootstrap.
# SLOTFLOW_SKIP_SYSTEM_PACKAGES=1
# SLOTFLOW_SKIP_DOCKER=1
# SLOTFLOW_NODE_VERSION=22
# SLOTFLOW_PNPM_VERSION=10.26.2
# SLOTFLOW_DOCKER_IMAGE=python:3.12
# SLOTFLOW_DOCKER_REGISTRY_MIRRORS=https://docker.1ms.run https://docker.m.daocloud.io https://dockerproxy.net
# SLOTFLOW_DOCKER_DAEMON_WAIT_SECONDS=20
